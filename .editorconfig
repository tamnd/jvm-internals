root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.py]
indent_size = 4

[*.{java,c,h,cpp,hpp}]
indent_size = 4

[*.rs]
indent_size = 4

# Markdown holds prose and the prose rule here is one paragraph per line, so
# there is no wrap column to set and trailing whitespace is never significant.
[*.md]
max_line_length = off
