# Build output
/build/
/site/
/.venv/
__pycache__/
*.pyc

# The JDK tarballs a reader downloads and CI publishes. Large, and every one of
# them is reproducible from the pin.
/jdks/
*.tar.gz
*.tar.xz
*.tar.zst

# OpenJDK build trees, for anyone working at E1 inside a checkout. A release
# tree is around 30 GB and there are three of them.
/jdk/
/build-*/

# Java and Rust build output
target/
*.class
*.jar
!jvx/lib/**/*.jar

# Runtime droppings. hs_err and replay files are useful and belong in the
# lesson that produced them, under a name that says which one, rather than at
# the repository root under whatever name HotSpot chose.
hs_err_pid*.log
replay_pid*.log
hotspot_pid*.log
core.*
*.jfr
*.hprof

# Notebook execution leftovers. The committed .ipynb files are generated by
# build.py and are the only notebooks that belong in git.
.ipynb_checkpoints/
/notebooks/**/*.nbconvert.ipynb

.DS_Store
