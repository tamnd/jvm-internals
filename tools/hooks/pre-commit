#!/bin/sh
#
# Refuse a commit whose notebooks are out of sync with their lesson source, and
# refuse one whose prose breaks the rules in CONTRIBUTING.md.
#
# Install it with:
#
#     git config core.hooksPath tools/hooks
#
# It is a hook rather than only a CI job because the failure it catches is boring
# and frequent: you edited lesson.py, you forgot to rebuild, and you find out six
# minutes later from a red check. Both of these run in about a second.
#
# The hook is advisory. `git commit --no-verify` still works, and CI is the thing
# that actually decides, because a check that only runs on machines that installed
# a hook is not a check.

set -e

python3 tools/build.py check || {
    echo
    echo "A notebook does not match its source. Run:"
    echo
    echo "    python3 tools/build.py notebooks"
    echo
    exit 1
}

python3 tools/prosecheck.py . || {
    echo
    echo "Prose rules. See the prose section of CONTRIBUTING.md."
    echo
    exit 1
}
